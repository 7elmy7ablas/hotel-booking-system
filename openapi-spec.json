{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Booking System API",
    "description": "RESTful API for hotel search, booking, and management",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@hotelbooking.com"
    }
  },
  "servers": [
    {
      "url": "https://api.hotelbooking.com/api",
      "description": "Production server"
    },
    {
      "url": "http://localhost:5000/api",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Hotels",
      "description": "Hotel search and information endpoints"
    },
    {
      "name": "Bookings",
      "description": "Booking management endpoints (requires authentication)"
    },
    {
      "name": "Authentication",
      "description": "User authentication endpoints"
    }
  ],
  "paths": {
    "/hotels": {
      "get": {
        "tags": ["Hotels"],
        "summary": "Search and filter hotels",
        "description": "Get a list of hotels with optional filters for city, price range, and rating",
        "operationId": "getHotels",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "description": "Filter hotels by city",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Cairo"
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "description": "Minimum price per night",
            "required": false,
            "schema": {
              "type": "number",
              "format": "decimal",
              "minimum": 0,
              "example": 100
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "description": "Maximum price per night",
            "required": false,
            "schema": {
              "type": "number",
              "format": "decimal",
              "minimum": 0,
              "example": 500
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "description": "Minimum hotel rating (0-5)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "decimal",
              "minimum": 0,
              "maximum": 5,
              "example": 4.0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Hotel"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/hotels/{id}/rooms": {
      "get": {
        "tags": ["Hotels"],
        "summary": "Get rooms for a specific hotel",
        "description": "Retrieve all rooms for a hotel with optional availability check",
        "operationId": "getHotelRooms",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Hotel ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "checkIn",
            "in": "query",
            "description": "Check-in date (YYYY-MM-DD)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-02-01"
            }
          },
          {
            "name": "checkOut",
            "in": "query",
            "description": "Check-out date (YYYY-MM-DD)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-02-05"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid date range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Hotel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "tags": ["Bookings"],
        "summary": "Create a new booking",
        "description": "Create a new hotel room booking (requires JWT authentication)",
        "operationId": "createBooking",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "Booking details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBooking"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid booking data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Room not available for selected dates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/bookings/my-bookings": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Get user's bookings",
        "description": "Retrieve all bookings for the authenticated user",
        "operationId": "getMyBookings",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by booking status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["Confirmed", "Cancelled", "Completed"],
              "example": "Confirmed"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication token"
      }
    },
    "schemas": {
      "Hotel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Grand Hotel Cairo"
          },
          "description": {
            "type": "string",
            "example": "Luxury 5-star hotel in the heart of Cairo"
          },
          "address": {
            "type": "string",
            "example": "123 Nile Street"
          },
          "city": {
            "type": "string",
            "example": "Cairo"
          },
          "country": {
            "type": "string",
            "example": "Egypt"
          },
          "rating": {
            "type": "number",
            "format": "decimal",
            "minimum": 0,
            "maximum": 5,
            "example": 4.5
          },
          "minPricePerNight": {
            "type": "number",
            "format": "decimal",
            "example": 150.00
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["WiFi", "Pool", "Gym", "Spa"]
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://cdn.example.com/hotels/1.jpg"
          }
        },
        "required": ["id", "name", "city", "rating"]
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 101
          },
          "hotelId": {
            "type": "integer",
            "example": 1
          },
          "roomNumber": {
            "type": "string",
            "example": "101"
          },
          "type": {
            "type": "string",
            "example": "Deluxe Double"
          },
          "description": {
            "type": "string",
            "example": "Spacious room with king-size bed"
          },
          "pricePerNight": {
            "type": "number",
            "format": "decimal",
            "example": 200.00
          },
          "capacity": {
            "type": "integer",
            "example": 2
          },
          "isAvailable": {
            "type": "boolean",
            "example": true
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["WiFi", "TV", "Mini Bar"]
          }
        },
        "required": ["id", "roomNumber", "type", "pricePerNight", "isAvailable"]
      },
      "CreateBooking": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "integer",
            "example": 101
          },
          "checkInDate": {
            "type": "string",
            "format": "date",
            "example": "2026-02-01"
          },
          "checkOutDate": {
            "type": "string",
            "format": "date",
            "example": "2026-02-05"
          },
          "guestName": {
            "type": "string",
            "example": "John Doe"
          },
          "guestEmail": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "guestPhone": {
            "type": "string",
            "example": "+201234567890"
          },
          "specialRequests": {
            "type": "string",
            "example": "Late check-in requested"
          }
        },
        "required": ["roomId", "checkInDate", "checkOutDate", "guestName", "guestEmail"]
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "confirmationNumber": {
            "type": "string",
            "example": "BK-2026-001234"
          },
          "roomId": {
            "type": "integer",
            "example": 101
          },
          "hotelName": {
            "type": "string",
            "example": "Grand Hotel Cairo"
          },
          "roomType": {
            "type": "string",
            "example": "Deluxe Double"
          },
          "checkInDate": {
            "type": "string",
            "format": "date",
            "example": "2026-02-01"
          },
          "checkOutDate": {
            "type": "string",
            "format": "date",
            "example": "2026-02-05"
          },
          "nights": {
            "type": "integer",
            "example": 4
          },
          "pricePerNight": {
            "type": "number",
            "format": "decimal",
            "example": 200.00
          },
          "totalPrice": {
            "type": "number",
            "format": "decimal",
            "example": 800.00
          },
          "guestName": {
            "type": "string",
            "example": "John Doe"
          },
          "guestEmail": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "guestPhone": {
            "type": "string",
            "example": "+201234567890"
          },
          "status": {
            "type": "string",
            "enum": ["Confirmed", "Cancelled", "Completed"],
            "example": "Confirmed"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-26T10:30:00Z"
          }
        },
        "required": ["id", "confirmationNumber", "status", "totalPrice"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Invalid request parameters"
          },
          "code": {
            "type": "string",
            "example": "INVALID_PARAMETERS"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["message"]
      }
    }
  }
}
